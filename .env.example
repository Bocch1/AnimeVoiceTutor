# Optional local-only configuration template. Copy to .env and customize locally.
# Prefer entering provider credentials in the application Settings UI.
# Never commit .env or paste real API keys into this example.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
ASR_URL=http://127.0.0.1:8766/transcribe
TTS_URL=http://127.0.0.1:9880/tts
TTS_ENABLED=true
REQUEST_TIMEOUT_SECONDS=180
TTS_MAX_ATTEMPTS=3
CORRECTION_MODE=gentle
SESSION_DB_PATH=data/app/conversations.sqlite3
# Tutor WebUI uses port 8767 by default; use AVT_WEB_PORT=8777 in a test terminal.
